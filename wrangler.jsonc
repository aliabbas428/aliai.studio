{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aliaistudio",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  "observability": {
    "enabled": true
  }
}